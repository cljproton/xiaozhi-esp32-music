{
    "manufacturer": "nologo",
    "type": "xingzhi-cube-2.0tft-wifi",
    "target": "esp32s3",
    "builds": [
        {
            "name": "xingzhi-cube-2.0tft-wifi",
            "language": "zh-CN",
            "wake_word": "nihaoxiaozhi",
            "sdkconfig_append": [
                "CONFIG_HTTPD_WS_SUPPORT=y",
                "CONFIG_HTTPD_MAX_URI_HANDLERS=64",
                "CONFIG_USE_RADIO=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_radio.csv\"",
                "CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16",
                "CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64",
                "CONFIG_ESP_WIFI_RX_BA_WIN=16",
                "CONFIG_ESP_WIFI_TX_BA_WIN=32",
                "CONFIG_LWIP_TCP_WND_DEFAULT=16384",
                "CONFIG_LWIP_TCP_SACK_OUT=y",
                "CONFIG_LWIP_TCP_RECVMBOX_SIZE=16",
                "CONFIG_LV_FONT_MONTSERRAT_48=y",
                "CONFIG_LV_FONT_MONTSERRAT_32=y",
                "CONFIG_LWIP_SNTP=y",
                "CONFIG_LWIP_SNTP_MAX_SERVERS=2",
                "CONFIG_COMPILER_DISABLE_GCC12_WARNINGS=y"
            ]
        }
    ]
}